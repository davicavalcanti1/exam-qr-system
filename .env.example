# ============================================================================
# ExameQR — variáveis de ambiente
# Copie para `.env` (backend) e `frontend/.env` (frontend) e preencha.
# ============================================================================

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# URL pública do app (base dos links gerados, ex.: link de confirmação de lote).
# Em produção: o domínio do app (ex.: https://app.examqr.com). Se vazio, o backend
# monta a partir do host da requisição.
APP_URL=

# ── Supabase (BACKEND / service role) ────────────────────────────────────────
# A service_role REAL do projeto. NUNCA use no frontend, nunca prefixe com VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha inicial gerada ao criar usuários pelo painel (troca obrigatória no 1º acesso).
DEFAULT_USER_PASSWORD=ExameQR@123

# ── uazapi (envio de WhatsApp) ───────────────────────────────────────────────
# Usado no link de confirmação de lote. Mesmos valores do controleoperacional.
# UAZAPI_URL aceita com ou sem /send/text. Token vem do secret do Supabase (controleoperacional).
UAZAPI_URL=https://imagoradiologia.uazapi.com/send/text
UAZAPI_TOKEN=

# ============================================================================
# FRONTEND — criar em `frontend/.env` (embutido no build do Vite)
# ============================================================================
# VITE_SUPABASE_URL=            # mesma URL do projeto Supabase
# VITE_SUPABASE_ANON_KEY=       # a chave ANON (pública), NÃO a service_role

# ============================================================================
# NOTAS
# ============================================================================
# • NetRis / Feegow NÃO vão aqui: a config de integração é POR EMPRESA, guardada
#   em `integracao_configs` (no banco), acessível só pelo backend.
# • Resend (e-mails) entra depois, junto com o domínio próprio.
# • Em produção (EasyPanel): forçar HTTPS no proxy (X-Forwarded-Proto = https).

# ── SSO com o Controle Operacional ─────────────────────────────────────────
# Chave PUBLICA do CO, em PEM. So verifica; nao assina nada — por isso um
# vazamento daqui nao permite forjar ticket. Vazia = SSO desligado (falha
# fechada, de proposito).
SSO_CO_PUBLIC_KEY=
# Precisa bater com o `aud` que o CO poe no ticket (o slug do modulo la).
SSO_AUDIENCIA=parceiros

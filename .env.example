# ============================================================================
# EXAM-QR-SYSTEM - Environment Variables
# ============================================================================
# Copy this file to .env and fill with your values
# ============================================================================

# SERVER
PORT=3000
NODE_ENV=development

# DATABASE
DB_PATH=./data/exam-qr.db

# JWT AUTHENTICATION
JWT_SECRET=sua-chave-secreta-super-segura-aqui-mude-isso-em-producao
JWT_EXPIRES_IN=7d

# QR CODE
QR_VALIDITY_HOURS=72
QR_MAX_USES=3

# API KEYS (Opcional - para integrações futuras)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# EMAIL (Opcional - para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app

# LOGGING
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# CORS (Segurança)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================================
# EXPLICAÇÕES
# ============================================================================

# PORT
#   Porta do servidor Express
#   Padrão: 3000
#   Exemplo: 3000, 8080, 5000

# NODE_ENV
#   Ambiente de execução
#   development | production | test
#   Use 'production' antes de deploy

# DB_PATH
#   Caminho do arquivo SQLite
#   Recomendação: guardar fora do git
#   Exemplo: ./data/exam-qr.db, /var/lib/exam-qr/db.sqlite

# JWT_SECRET
#   Chave para assinar tokens JWT
#   ⚠️ MUDE ISSO EM PRODUÇÃO! Use senha forte e aleatória
#   Gerar: openssl rand -base64 32

# JWT_EXPIRES_IN
#   Tempo de expiração do token
#   Formatos: "7d", "24h", "30m", "3600s"

# QR_VALIDITY_HOURS
#   Quantas horas o QR code fica válido
#   Padrão: 72 (3 dias)

# QR_MAX_USES
#   Máximo de usos por QR code
#   Padrão: 3

# STRIPE_* (Opcional)
#   Para integração de pagamentos
#   Obtenha em: https://stripe.com

# SMTP_* (Opcional)
#   Para enviar emails de notificação
#   Gmail: Use App Password (não a senha normal)

# LOG_LEVEL
#   error | warn | info | debug
#   Produção: info ou warn
#   Desenvolvimento: debug

# CORS_ORIGIN
#   URLs permitidas para requisições cross-origin
#   Separe por vírgula: http://localhost:3000,https://app.example.com
#   Produção: Configure com domínio específico

# ============================================================================
# EXEMPLO PARA PRODUÇÃO
# ============================================================================

# PORT=3000
# NODE_ENV=production
# DB_PATH=/var/lib/exam-qr/exam-qr.db
# JWT_SECRET=f7q3p8k2m9x1c5b4v6n7z8a9d0e1f2g3h4i5j6k7l8m9n0o1p2q3r4s5t6u7v8
# JWT_EXPIRES_IN=7d
# LOG_LEVEL=info
# CORS_ORIGIN=https://app.example.com,https://terminal.example.com

# ============================================================================

# ── NetRis (integração com o sistema da clínica) ─────────────────────────────
# Base do gateway NetRis (ex.: https://SEU-HOST/). O token vai no header Authorization.
NETRIS_BASE_URL=
NETRIS_TOKEN=
NETRIS_FILIAL_ID=
